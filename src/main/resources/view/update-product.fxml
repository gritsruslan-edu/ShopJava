<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.UpdateProductController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Оновлення товару"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="ID:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <TextField fx:id="idField"
                   editable="false"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

        <Label text="Назва:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <TextField fx:id="nameField"
                   promptText="Назва товару"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

        <Label text="Ціна:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField fx:id="priceField"
                   promptText="Ціна"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Тип:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField fx:id="typeField"
                   promptText="Тип товару"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

        <Label text="Кількість:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField fx:id="quantityField"
                   promptText="Кількість"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Оновити"
                onAction="#handleUpdateProduct"/>

        <Button text="Скасувати"
                onAction="#handleCancel"/>
    </HBox>

</VBox>